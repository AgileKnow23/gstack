# repo-map.yml — the one project-specific file in this workspace.
#
# One reusable engine, one project-specific configuration file. The skill that
# generated this workspace is identical in every repository; everything that makes
# THIS repository different lives here. When an agent is wrong about the project,
# this file is wrong — fix it here, not by arguing with the agent.
#
# Keep it factual. This file records where facts live; it does not restate them.
# If a sentence here could go stale independently of the thing it describes, it
# belongs in the document it points at instead.

schema: icm-repo-workspace/v1

repo:
  name: "{REPO_NAME}"
  # context-map  — the repo is a graph of domains/teams/data with no fixed run order
  # pipeline     — the repo runs a known sequence with a deliverable at the end
  # composed     — a map whose domains each carry small pipelines (most real repos)
  form: "{context-map|pipeline|composed}"
  # No summary here on purpose. "What is this repo and what ships out of it" must be
  # answerable from the entry file without opening anything else, so that sentence
  # lives in AGENTS.md and only there. One home per fact.
  entry: AGENTS.md

# Ordered. First entry is where a cold agent starts. Point at documents that
# already exist — this list is a catalog, not a wish list.
sources_of_truth:
  - path: "{PATH/TO/DOC.md}"
    holds: "{what question this document is the answer to}"
    read_when: "{the trigger that makes it worth the tokens}"

# The nodes of the map. A domain is a part of the repo that can be reasoned about
# on its own. Two domains touched by one change = cross-domain.
domains:
  - name: "{domain-name}"
    paths:
      - "{src/path/one}"
    doc: "{PATH/TO/DOMAIN/DOC.md}"   # optional; omit rather than invent
    risk: []                          # any of the risk_markers keys below

# The relevant command, by intent. Omit a key rather than guess at it — a wrong
# command costs more than a missing one. dev_url is what makes browser QA possible;
# leave it null when nothing runnable exists and QA will correctly be skipped.
commands:
  install: "{install command}"
  build: "{build command}"
  test: "{unit test command}"
  lint: "{lint command}"
  e2e: "{e2e command}"
  dev_url: null

# Human gates. An agent never clears its own gate.
gates:
  - id: deploy
    when: any deployment, release, or production configuration change
    requires: explicit user authorization, every time — prior approval never carries forward
    self_clearable: false

# What escalates routing. Each key maps to path fragments or literals that, when
# they appear in a change, mark it as carrying that risk. Empty list = this repo
# has no such surface, which is a real and useful answer.
risk_markers:
  tenant_isolation: []
  auth: []
  billing: []
  externally_reachable: []

# Optional. Per-repo deviations from the standard routing rules, each with a
# reason. An override without a reason is ritual wearing the costume of judgment.
routing_overrides: []
